viewBox=\"0 0 512 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z\"><\/path><\/svg>\t\t\t\t<\/span>\n\t\t\t<\/div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-icon-box-content\">\n\n\t\t\t\t\t\t\t\t\t<h3 class=\"elementor-icon-box-title\">\n\t\t\t\t\t\t<span  >\n\t\t\t\t\t\t\tB\u1ea3o h\u00e0nh sau b\u00e1n\t\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/h3>\n\t\t\t\t\n\t\t\t\t\n\t\t\t<\/div>\n\t\t\t\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-02e9a75 elementor-view-stacked elementor-widget__width-initial elementor-widget-mobile__width-initial elementor-position-inline-start elementor-mobile-position-inline-start elementor-shape-circle elementor-invisible elementor-widget elementor-widget-icon-box\" data-id=\"02e9a75\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;_animation&quot;:&quot;fadeInUp&quot;,&quot;_animation_delay&quot;:800}\" data-widget_type=\"icon-box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-box-wrapper\">\n\n\t\t\t\t\t\t<div class=\"elementor-icon-box-icon\">\n\t\t\t\t<span  class=\"elementor-icon\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-far-check-circle\" viewBox=\"0 0 512 512\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z\"><\/path><\/svg>\t\t\t\t<\/span>\n\t\t\t<\/div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-icon-box-content\">\n\n\t\t\t\t\t\t\t\t\t<h3 class=\"elementor-icon-box-title\">\n\t\t\t\t\t\t<span  >\n\t\t\t\t\t\t\tCh\u1ea5t l\u01b0\u1ee3ng \u2013 Gi\u00e1 t\u1ed1t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/h3>\n\t\t\t\t\n\t\t\t\t\n\t\t\t<\/div>\n\t\t\t\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-7c5acab elementor-widget elementor-widget-html\" data-id=\"7c5acab\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\n\/* ================================\n   HI\u1ec6U \u1ee8NG CH\u1eee T\u1eeaNG K\u00dd T\u1ef0\n================================ *\/\n\n.text-tung-chu {\n    width: 100% !important;\n    text-align: left !important;\n    white-space: normal !important;\n    word-break: normal !important;\n    overflow-wrap: normal !important;\n}\n\n\/* T\u1eebng t\u1eeb *\/\n.text-tung-chu .word {\n    display: inline-block;\n    white-space: nowrap;\n}\n\n\/* T\u1eebng ch\u1eef *\/\n.text-tung-chu .char {\n    display: inline-block;\n    opacity: 0;\n    transform: translateY(15px);\n    transition:\n        opacity 0.3s ease,\n        transform 0.3s ease;\n}\n\n\/* Ch\u1eef xu\u1ea5t hi\u1ec7n *\/\n.text-tung-chu .char.show {\n    opacity: 1;\n    transform: translateY(0);\n}\n\n\n\/* ================================\n   MOBILE\n================================ *\/\n\n@media (max-width: 767px) {\n\n    .text-tung-chu {\n        width: 100% !important;\n        text-align: left !important;\n        padding-left: 0 !important;\n        padding-right: 0 !important;\n    }\n\n}\n<\/style>\n\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n\n    const elements = document.querySelectorAll('.text-tung-chu');\n\n    elements.forEach(function (element) {\n\n        \/* Tr\u00e1nh ch\u1ea1y l\u1ea1i script *\/\n        if (element.dataset.textAnimated === 'true') {\n            return;\n        }\n\n        element.dataset.textAnimated = 'true';\n\n        const walker = document.createTreeWalker(\n            element,\n            NodeFilter.SHOW_TEXT,\n            null\n        );\n\n        const textNodes = [];\n        let node;\n\n        while (node = walker.nextNode()) {\n\n            if (node.textContent.trim() !== '') {\n                textNodes.push(node);\n            }\n\n        }\n\n        textNodes.forEach(function (textNode) {\n\n            const fragment = document.createDocumentFragment();\n\n            \/* T\u00e1ch ch\u1eef v\u00e0 d\u1ea5u c\u00e1ch *\/\n            const parts = textNode.textContent.split(\/(\\s+)\/);\n\n            parts.forEach(function (part) {\n\n                \/* N\u1ebfu l\u00e0 kho\u1ea3ng tr\u1eafng *\/\n                if (\/^\\s+$\/.test(part)) {\n\n                    fragment.appendChild(\n                        document.createTextNode(part)\n                    );\n\n                    return;\n                }\n\n                \/* N\u1ebfu l\u00e0 ch\u1eef *\/\n                if (part.length > 0) {\n\n                    const word = document.createElement('span');\n\n                    word.className = 'word';\n\n                    [...part].forEach(function (char) {\n\n                        const span = document.createElement('span');\n\n                        span.className = 'char';\n\n                        span.textContent = char;\n\n                        word.appendChild(span);\n\n                    });\n\n                    fragment.appendChild(word);\n                }\n\n            });\n\n            textNode.parentNode.replaceChild(\n                fragment,\n                textNode\n            );\n\n        });\n\n\n        \/* Animation t\u1eebng ch\u1eef *\/\n        const chars = element.querySelectorAll('.char');\n\n        chars.forEach(function (char, index) {\n\n            setTimeout(function () {\n\n                char.classList.add('show');\n\n            }, index * 25);\n\n        });\n\n    });\n\n});\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-c6f25bf animated-fast e-flex e-con-boxed elementor-invisible e-con e-parent\" data-id=\"c6f25bf\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;animation&quot;:&quot;fadeInUp&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-904b272 elementor-widget__width-initial elementor-widget-mobile__width-initial elementor-widget elementor-widget-heading\" data-id=\"904b272\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">th\u01b0\u01a1ng hi\u1ec7u n\u1ed5i b\u1eadt:<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-c65959a elementor-widget elementor-widget-image-carousel\" data-id=\"c65959a\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;slides_to_show&quot;:&quot;5&quot;,&quot;slides_to_show_tablet&quot;:&quot;5&quot;,&quot;slides_to_show_mobile&quot;:&quot;3&quot;,&quot;navigation&quot;:&quot;none&quot;,&quot;slides_to_scroll&quot;:&quot;1&quot;,&quot;autoplay_speed&quot;:0,&quot;speed&quot;:10000,&quot;autoplay&quot;:&quot;yes&quot;,&quot;pause_on_interaction&quot;:&quot;yes&quot;,&quot;infinite&quot;:&quot;yes&quo